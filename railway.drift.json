{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'drift: nothing to build — tsx runs src/ directly'",
    "watchPatterns": ["src/impact-drift.ts", "src/drift.ts", "src/planner.ts", "src/pool.ts", "package.json", "pnpm-lock.yaml", "railway.drift.json"]
  },
  "deploy": {
    "startCommand": "pnpm drift --loop",
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 100
  }
}
