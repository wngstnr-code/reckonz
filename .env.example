# Deployer key for X Layer testnet (chainId 1952). Never commit the real file.
PRIVATE_KEY=0x

# Settlement token used for portfolio-level weight checks.
# Mainnet USDG: 0x4ae46a509F6b1D9056937BA4500cb143933D2dc8
# On testnet, point this at a deployed mock.
CASH=0x4ae46a509F6b1D9056937BA4500cb143933D2dc8

# Thesis Compiler — required. Free tier: https://aistudio.google.com/apikey
# Without it the compile stage refuses to run. It does NOT quietly fall back to
# the recorded fixture: that returned the same thesis for any input, which reads
# as a working pipeline rather than as a missing key.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# LLM_PROVIDER=gemini    # force the live one, and fail loudly if the key is absent
# LLM_PROVIDER=fixture   # the recorded thesis, on purpose — ignores the input text

# Safe co-owner keys, for admin actions the 2-of-3 must sign (pnpm safe:admin).
# Threshold is 2, so one key is never enough. Supply at least one of these
# alongside PRIVATE_KEY. Never put a key on a command line — shell history keeps it.
#   owner 1  0xD7360Dc3ED4fE01bEbB8477594A76CBFb5c79BA5  (PRIVATE_KEY, the deployer)
#   owner 2  0x75d120B0CC9B9FC3A4bEC6e442BE74ad0E511fBd
#   owner 3  0x832ebF3d6b96e3A4c53b243F6107BbBEFC25582f
SAFE_OWNER_2_KEY=
SAFE_OWNER_3_KEY=

# The publisher hot key. publish() only — it administers nothing.
#   0x40101A4932dEb95f0A5951BB7fB0fFa7c17e3Ab8
PUBLISHER_KEY=

# Where evidence bundles are archived in production (D80). Vercel injects this
# when the `reckonz-evidence` blob store is connected to the project; locally it
# is absent and bundles are written to evidence/ instead. With neither, a fill
# reports `persistence: none` and the browser offers the JSON as a download —
# the hash still goes on chain, but nobody could ever audit it.
BLOB_READ_WRITE_TOKEN=

# The public host of that store, so `pnpm evidence` can verify a bundle produced
# in production from a fresh clone. Set as a committed default in
# src/evidence-store.ts once the store exists; this override is for a fork.
EVIDENCE_BLOB_BASE=
