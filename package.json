{
  "name": "reckonz",
  "version": "1.0.0",
  "description": "Reckonz — non-custodial execution and risk tooling for tokenised equities on X Layer",
  "main": "index.js",
  "scripts": {
    "verify": "tsx src/verify.ts",
    "verify:abi": "forge build && tsx src/verify-abi.ts",
    "plan": "tsx src/demo.ts",
    "capacity": "tsx src/capacity.ts",
    "typecheck": "tsc --noEmit",
    "oracle": "tsx src/oracle-demo.ts",
    "reconcile": "tsx src/reconcile-demo.ts",
    "measure": "tsx src/measure.ts",
    "sample": "tsx src/sample.ts",
    "build": "next build",
    "build:contracts": "forge build",
    "test:sol": "forge test",
    "test:unit": "tsx --test src/*.test.ts app/components/*.test.ts",
    "test": "pnpm test:unit && pnpm test:sol",
    "check:tests": "tsx src/check-tests.ts",
    "deploy": "forge script script/Deploy.s.sol --tc Deploy --rpc-url xlayer_testnet --broadcast",
    "thesis": "tsx src/thesis-demo.ts",
    "thesis:publish": "tsx src/thesis-publish.ts",
    "thesis:gemini": "LLM_PROVIDER=gemini tsx src/thesis-demo.ts",
    "oracle:publish": "tsx src/publish.ts",
    "mandate": "tsx src/mandate-demo.ts",
    "mandate:create": "tsx src/mandate-create.ts",
    "mandate:show": "tsx src/mandate-show.ts",
    "mandate:edit": "tsx src/mandate-edit.ts",
    "dev": "next dev",
    "start": "next start",
    "execute": "tsx src/execute.ts",
    "exit": "tsx src/exit.ts",
    "evidence": "tsx src/evidence-demo.ts",
    "breaker": "tsx src/breaker.ts",
    "fees": "tsx src/fees.ts",
    "swap": "tsx src/swap.ts",
    "safe:prove": "tsx src/safe-prove.ts",
    "safe:admin": "tsx src/safe-admin.ts",
    "handover": "tsx src/handover.ts",
    "publish:loop": "tsx src/publish-loop.ts",
    "track-record": "tsx src/track-record-demo.ts",
    "index": "tsx src/index-demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@vercel/blob": "^2.8.0",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
